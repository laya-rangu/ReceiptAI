APP_ENV=development
DATABASE_URL=sqlite:///./data/receiptai.db
STORAGE_PATH=./data/files
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEED_DEMO=true
JOB_MODE=inline
REDIS_URL=redis://localhost:6379/0
# Optional. Without a key, uploads open an empty review form for manual entry.
OPENAI_API_KEY=
EXTRACTION_MODEL=gpt-4.1-mini
